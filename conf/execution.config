// Resolve before the local executor is constructed. All entry points use the
// same Python policy implementation; the DAG only materializes this decision.
params.bootstrap_execution_policy = {
    def mode = System.getenv('IGV_SCC_SLOTS') ? 'scc' : params.runtime_execution_mode
    if (!mode || mode == 'unconfigured') mode = 'standalone'
    def command = [params.python.toString(), "${projectDir}/bin/resolve_execution_policy.py", '--stdout',
        '--execution-mode', mode.toString(), '--max-parallel', params.max_parallel.toString(),
        '--igv-cpus', params.igv_cpus.toString(), '--igv-memory', params.igv_memory.toString(),
        '--igv-timeout', params.igv_timeout.toString(),
        '--normalization-cpus', params.normalization_cpus.toString(),
        '--normalization-memory', params.normalization_memory.toString(),
        '--normalization-timeout', params.normalization_timeout.toString()]
    def policyBuilder = new ProcessBuilder(command.collect { it.toString() }).redirectErrorStream(true)
    def previousPythonPath = policyBuilder.environment().get('PYTHONPATH')
    policyBuilder.environment().put('PYTHONPATH', ("${projectDir}/src" + (previousPythonPath ? ":${previousPythonPath}" : '')).toString())
    def policyProcess = policyBuilder.start()
    policyProcess.waitForOrKill(30000)
    def policyOutput = policyProcess.inputStream.getText('UTF-8')
    if (policyProcess.exitValue() != 0) {
        throw new IllegalStateException("Execution policy bootstrap failed: ${policyOutput}")
    }
    return policyOutput.trim()
}.call()
params.bootstrap_decision = new groovy.json.JsonSlurperClassic().parseText(params.bootstrap_execution_policy.toString())

executor {
    cpus = params.bootstrap_decision.resource_envelope.cpu_slots as int
    memory = "${params.bootstrap_decision.resource_envelope.usable_memory_bytes ?: params.bootstrap_decision.render.attempts[0].memory_bytes} B"
    queueSize = params.bootstrap_decision.concurrency.effective_max_parallel as int
}
process {
    withLabel: portable_render {
        maxForks = params.bootstrap_decision.concurrency.effective_max_parallel as int
    }
    withLabel: igv_render {
        maxForks = params.bootstrap_decision.concurrency.effective_max_parallel as int
    }
}
